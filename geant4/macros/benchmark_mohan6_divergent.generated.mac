# 6 MV benchmark from a CITED spectrum: Mohan et al 6 MV spectrum: cts/bin or /MeV
# Generated by scripts/egsnrc_spectrum_to_macro.py. Energies in MeV.
# Beam: DIVERGENT point source (SSD modelled).
# Run with run.config geometry = water_box (needs world_half_z_cm >= 120).
/run/initialize

/score/create/boxMesh pdd
/score/mesh/boxSize 2. 2. 15. cm
/score/mesh/nBin 4 4 300
/score/mesh/translate/xyz 0 0 0 cm
/score/quantity/doseDeposit dose Gy
/score/close

/gps/particle gamma
# DIVERGENT point source: SSD 100 cm, field 10 cm at surface,
# half-angle 2.8624 deg. Circular field (iso cone) ~ the 10x10
# square field for central-axis PDD. Needs world_half_z_cm >= 120.
/gps/pos/type Point
/gps/pos/centre 0 0 -115 cm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 -1 0
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 2.8624 deg

/gps/ene/type Arb
/gps/hist/type arb
/gps/hist/point 0.1250 1.020542e-03
/gps/hist/point 0.3750 3.217721e-02
/gps/hist/point 0.6250 1.145059e-01
/gps/hist/point 0.8750 1.145059e-01
/gps/hist/point 1.1250 1.102044e-01
/gps/hist/point 1.3750 1.014863e-01
/gps/hist/point 1.6250 1.014863e-01
/gps/hist/point 1.8750 6.202282e-02
/gps/hist/point 2.1250 5.882261e-02
/gps/hist/point 2.3750 4.638703e-02
/gps/hist/point 2.6250 3.435115e-02
/gps/hist/point 2.8750 3.240995e-02
/gps/hist/point 3.1250 3.687928e-02
/gps/hist/point 3.3750 2.359230e-02
/gps/hist/point 3.6250 3.096995e-02
/gps/hist/point 3.8750 2.428053e-02
/gps/hist/point 4.1250 2.209113e-02
/gps/hist/point 4.3750 1.280682e-02
/gps/hist/point 4.6250 1.039471e-02
/gps/hist/point 4.8750 1.193327e-02
/gps/hist/point 5.1250 4.036505e-03
/gps/hist/point 5.3750 6.746047e-03
/gps/hist/point 5.6250 2.979585e-03
/gps/hist/point 5.8750 3.909712e-03
/gps/hist/inter Lin

/run/printProgress 1000000
/run/beamOn 20000000

/score/dumpQuantityToFile pdd dose reports/benchmark_mc/pdd_mohan6_divergent.txt
